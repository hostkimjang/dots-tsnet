# dots-tsnet 설정 파일입니다. KEY=VALUE 형식만 쓰고 셸 확장은 하지 않습니다.
# 각 값의 뜻은 README 의 "설정" 표를 참고하세요.
DOTS_TS_DIR=/workspace/.dots-tailscale
TSNET_EXIT_NODE=
TSNET_SOCKS_PORT=1055
TSNET_HTTP_PORT=1056
TSNET_NO_PROXY=localhost,127.0.0.1,::1,browser-proxy
TSNET_AUTO_PROXY=1
TSNET_APT_SHIM=1
TSNET_SUDO_SHIM=1
TSNET_PYTHONPATH=1
TSNET_APT_SOURCES=official
TSNET_APT_PROXY=
